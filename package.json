{
  "name": "dsh-smart-router",
  "description": "Automatic model routing for DeepSeek Harness: a virtual `smart` model classifies every request by difficulty (hard / normal / easy) and by vision need, then delegates to the models you already configured in Settings → Models. 内置智能路由：三级难度 + 视觉自动路由，模型从「设置-模型」已配置模型中选取，虚拟 smart 模型零配置接入。",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "router",
    "routing",
    "model-routing",
    "vision",
    "classifier",
    "tier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rouyiemei/dsh-smart-router.git"
  },
  "homepage": "https://github.com/rouyiemei/dsh-smart-router",
  "bugs": {
    "url": "https://github.com/rouyiemei/dsh-smart-router/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "index.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/",
    "check": "node --test tests/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
